# Keep the supplied Neon credentials in .env or .env.local, never in client code.
DATABASE_URL=
# Optional direct connection for migrations; falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Set the real HTTPS origin before launch; omit locally to use localhost.
SITE_URL=http://localhost:3000
# Enable indexing only when actual page content is ready.
SITE_INDEXABLE=false

# Generate a random secret before exposing the contact API publicly.
# Example: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CONTACT_RATE_LIMIT_SECRET=
# Which trusted proxy header supplies the visitor IP: none, x-forwarded-for,
# x-real-ip, or cf-connecting-ip. Only enable behind a proxy that overwrites it.
CONTACT_IP_HEADER=none
